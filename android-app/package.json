{
  "name": "libreaudio-pro-android",
  "version": "1.0.0",
  "description": "LibreAudio PRO - Aplicación Android",
  "main": "index.js",
  "scripts": {
    "build": "npm run copy-assets",
    "copy-assets": "rm -rf www && mkdir -p www && cp -r ../docs/* www/",
    "cap:sync": "npx cap sync",
    "cap:update": "npx cap update",
    "cap:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "radio",
    "podcast",
    "audio",
    "pwa",
    "capacitor",
    "android"
  ],
  "author": "LibreAudio PRO",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
