# Security Salt - CHANGE THIS IN PRODUCTION!
SECURITY_SALT=your_random_security_salt_change_this_in_production

# Database Configuration (for local development)
DATABASE_URL=mysql://libreaudiopro:libreaudiopro_pass@mysql:3306/libreaudiopro?encoding=utf8mb4

# Database Configuration (for Railway - use ${{ }} syntax)
# DB_HOST=${{ DATABASE_URL_REPLICA.HOSTNAME }}
# DB_PORT=${{ DATABASE_URL_REPLICA.PORT }}
# DB_NAME=${{ DATABASE_URL_REPLICA.PATH }}
# DB_USERNAME=${{ DATABASE_URL_REPLICA.USERNAME }}
# DB_PASSWORD=${{ DATABASE_URL_REPLICA.PASSWORD }}

# Debug mode (set to false in production)
DEBUG=false

# Application Configuration
APP_NAME=LibreAudio PRO
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=es_ES
APP_DEFAULT_TIMEZONE=UTC
DB_ENGINE=Mysql
